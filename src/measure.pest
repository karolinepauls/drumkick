// e.g.: 1:kick,hat &:hat 2:snare,hat &:hat 3:kick,hat &:hat 4:snare,hat
sample_name        = { (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "-" | "_")* }
samples_list       = { sample_name ~ ("," ~ sample_name)* ~ ","? }
beat_no            = {
    ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*
}
beat_fraction_name = { "e" | "&" | "and" | "ah" | "uh" | "a" | "trip" | "tri" | "let" | "plet" }
beat_fraction      = { ASCII_NONZERO_DIGIT ~ "/" ~ ASCII_NONZERO_DIGIT }
placement          = { beat_fraction | beat_fraction_name | beat_no }
beat               = { (placement ~ ":") ~ samples_list }
measure            = { SOI ~ " "* ~ beat ~ (" "+ ~ beat)* ~ " "* ~ EOI }
